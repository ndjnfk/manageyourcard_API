# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# MongoDB
#--------------------------------------------------------------------
# Where the shopkeeper register is stored. The primary collection is
# "users" — one document per registered shop.
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=manage-your-card

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:4200

#--------------------------------------------------------------------
# Where the browser app lives
#--------------------------------------------------------------------
# APP_URL above is this API. This is the Angular app — where a tapped
# notification opens, and what the links in a reminder email point at.
WEB_APP_URL=http://localhost:4200

#--------------------------------------------------------------------
# Firebase Cloud Messaging — push to browsers and installed PWAs
#--------------------------------------------------------------------
# Firebase console → Project Settings → Service accounts → "Generate new
# private key". Copy these three fields out of the downloaded JSON; do not
# commit the file itself.
#
# Leave blank to run without push — the API reports it as unconfigured
# rather than failing to boot.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The private_key value, in double quotes, with its \n sequences left as-is.
FIREBASE_PRIVATE_KEY=

#--------------------------------------------------------------------
# Email — Resend
#--------------------------------------------------------------------
# resend.com → API Keys. Leave blank to run without reminder emails.
RESEND_API_KEY=
# Must sit on a domain verified in Resend. Their onboarding@resend.dev works
# without a domain, but only delivers to the Resend account owner's inbox.
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME=manageyourcard

#--------------------------------------------------------------------
# Reminders
#--------------------------------------------------------------------
# Days ahead of a due date to start reminding. Matches the dashboard's
# "Due Soon" window, so a reminder agrees with the badge on the card.
REMINDER_LEAD_DAYS=7
#--------------------------------------------------------------------
# Scheduler — the reminder sweep, on a timer inside the API process
#--------------------------------------------------------------------
# The API sweeps the register itself, so a plain `node bin/server.js`
# deployment sends reminders without a crontab having to be set up too.
# Set to false where the host already schedules `node ace reminders:send`,
# so the reminders have one owner rather than two.
SCHEDULER_ENABLED=true
# The zone the expressions below are read in — not the server clock, which
# is UTC. "0 6 * * *" against UTC would fire at 11:30am India time.
SCHEDULER_TIMEZONE=Asia/Kolkata
# Daily digest — push, email and the in-app list. 6am.
REMINDER_CRON=0 6 * * *
# End-of-day "still open today" alert — push and the in-app list, never
# email. Unset means it is not scheduled at all.
# DUE_TODAY_CRON=30 17 * * *
# Claim each run in Redis before sweeping, so only one instance does it.
# For deployments running several copies of the API. Not needed for
# correctness — a reminder is claimed per shop, per channel, per day in
# MongoDB before it is sent, so a second sweep sends nothing.
SCHEDULER_DISTRIBUTED=false
# TESTING ONLY — re-send on every run, ignoring the once-a-day log. Pair it
# with a short REMINDER_CRON (e.g. "* * * * *") to watch notifications
# arrive; without it the second run of the day correctly sends nothing.
# Ignored when NODE_ENV=production. With SMTP against Gmail this mails on
# every fire, and Google locks accounts that send like a mailing list.
SCHEDULER_FORCE=false

#--------------------------------------------------------------------
# Card purge — DESTRUCTIVE
#--------------------------------------------------------------------
# When to delete cards that have served their four days on the history
# page. UNSET MEANS NEVER, and that is the default on purpose.
#
# This deletes records permanently — customer name, mobile, every date,
# the renewal count, the note. There is no undo and no archive. A card
# removed here can never answer "has this customer been in before?".
#
# See what it would take before switching it on:
#   node ace cards:purge --dry-run
# CARD_PURGE_CRON=30 3 * * *
