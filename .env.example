# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# MongoDB
#--------------------------------------------------------------------
# Where the shopkeeper register is stored. The primary collection is
# "users" — one document per registered shop.
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=manage-your-card

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:4200